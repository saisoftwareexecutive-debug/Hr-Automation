# ==============================================================================
# HireFlow Environment Configuration Example
# Copy this file to .env.local for local execution or configure in Vercel settings
# NEVER commit .env or .env.local to version control!
# ==============================================================================

# Data Storage Engine Mode:
# 'local'    -> Uses local offline JSON database in data/hireflow_db.json (single office PC)
# 'supabase' -> Uses cloud-hosted PostgreSQL database via Supabase Free Tier (multi-user web)
DATA_STORAGE_MODE=local

# Public Base URL of the deployment (used for public screening form links in WhatsApp / SMS)
# In production on Vercel: set to https://<your-project>.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ==============================================================================
# Supabase Configuration (Required when DATA_STORAGE_MODE=supabase)
# Create a free project at https://supabase.com (Free Tier: 500 MB database, 1 GB storage)
# ==============================================================================
# Project URL from Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Anon / Public Key (Safe for browser client requests)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-placeholder

# Service Role Secret Key (CRITICAL: Server-side only! NEVER prefix with NEXT_PUBLIC_)
# Used exclusively by backend API routes for elevated database operations with RLS bypass
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-placeholder

# ==============================================================================
# Authentication & Session Security
# Required in production: must be a high-entropy cryptographically random string (min 32 chars)
# Generate via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ==============================================================================
SESSION_SECRET=your-random-32-character-session-secret-placeholder
AUTH_SECRET=your-random-32-character-session-secret-placeholder

# ==============================================================================
# Testing & CI Configuration (Optional)
# Used during automated testing or CI pipelines to isolate test data storage
# ==============================================================================
# Custom path for test JSON database file (used by vitest and smoke tests)
# HIREFLOW_DATA_FILE=/tmp/hireflow_test.json
